# Copy to .env and fill in real values. Never commit a real .env.

# SQLAlchemy URL. Local default (SQLite):
DATABASE_URL=sqlite:///./quotes.db
# Production (PostgreSQL on Supabase):
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres

# Secret used to sign JWTs. Use a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string
